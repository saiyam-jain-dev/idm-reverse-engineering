{
  "manifest_version": 3,
  "name": "Independent Download Helper",
  "version": "0.1.0",
  "description": "Send direct links and page media URLs to the desktop download manager.",
  "key": "",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Independent Download Helper",
    "default_popup": "popup.html"
  }
}
